" ============================================================
"  IdeaVim Configuration
" ============================================================

" --- Leader key ---
let mapleader = " "

" ============================================================
"  SYSTEM CLIPBOARD
" ============================================================
" All yank, delete, and paste operations use the system clipboard.
" This means y/d/p work seamlessly with your OS clipboard.
set clipboard+=unnamed
set clipboard+=unnamedplus

" ============================================================
"  CORE BEHAVIOUR
" ============================================================
set scrolloff=8          " Keep 8 lines visible above/below cursor
set number               " Show line numbers
set relativenumber       " Relative line numbers (great for motions)
set ignorecase           " Case-insensitive search...
set smartcase            " ...unless the query has uppercase
set incsearch            " Incremental search highlighting
set hlsearch             " Highlight all search matches
set showmode             " Show current mode in status bar
set showcmd              " Show partial commands
set history=1000         " Remember lots of command history
set timeoutlen=500       " Snappy leader key timeout (ms)
set visualbell           " No annoying beeps

" ============================================================
"  IDEAVIM PLUGINS (built-in emulations)
" ============================================================
set surround             " cs/ds/ys — change, delete, add surrounds
set commentary           " gc — toggle comments
set ideamarks            " Sync IdeaVim marks with IDE bookmarks
set argtextobj           " ia/aa — argument text objects
set textobj-entire       " ie/ae — entire buffer text object
set ReplaceWithRegister  " gr — replace motion with register content
set NERDTree             " File tree via :NERDTree

" Use IDE's join (J) for smart code-aware joining
set ideajoin

" Use IDE's refactor rename for the Vim 'cw' name-change
set idearefactormode=normal

" ============================================================
"  SEARCH & NAVIGATION
" ============================================================
" Clear search highlights with Escape
nnoremap <Esc> :nohlsearch<CR>

" Centre screen after search jumps
nnoremap n nzz
nnoremap N Nzz

" Centre screen after half-page jumps
nnoremap <C-d> <C-d>zz
nnoremap <C-u> <C-u>zz

" ============================================================
"  WINDOW / SPLIT NAVIGATION
" ============================================================
nnoremap <C-h> <C-w>h
nnoremap <C-l> <C-w>l
nnoremap <C-j> <C-w>j
nnoremap <C-k> <C-w>k

" ============================================================
"  CLIPBOARD — EXPLICIT MAPPINGS
" ============================================================
" Yank to system clipboard
nnoremap <leader>y "+y
vnoremap <leader>y "+y
nnoremap <leader>Y "+Y

" Paste from system clipboard
nnoremap <leader>p "+p
nnoremap <leader>P "+P
vnoremap <leader>p "+p

" Delete without clobbering the yank register (sends to black hole)
nnoremap <leader>d "_d
vnoremap <leader>d "_d

" Paste over selection without losing the yanked text
vnoremap <leader>p "_dP

" ============================================================
"  EDITING QUALITY OF LIFE
" ============================================================
" Stay in visual mode after indenting
vnoremap < <gv
vnoremap > >gv

" Move selected lines up/down
vnoremap J :m '>+1<CR>gv=gv
vnoremap K :m '<-2<CR>gv=gv

" Keep cursor position when joining lines
nnoremap J mzJ`z

" Quick save
nnoremap <leader>w :w<CR>

" ============================================================
"  IDE ACTIONS
" ============================================================
" Find everywhere (double shift)
nnoremap <leader>ff :action SearchEverywhere<CR>

" Recent files
nnoremap <leader>fr :RecentFiles<CR>

" Go to file
nnoremap <leader>fg :GotoFile<CR>

" File structure popup (like a minimap/outline)
nnoremap <leader>fs :FileStructurePopup<CR>

" Go to declaration / implementation
nnoremap gd :GotoDeclaration<CR>
nnoremap gi :GotoImplementation<CR>
nnoremap gr :FindUsages<CR>
nnoremap gy :GotoTypeDeclaration<CR>

" Hover documentation
nnoremap K :QuickJavaDoc<CR>

" Rename refactor
nnoremap <leader>rn :RenameElement<CR>

" Quick fix / intentions
nnoremap <leader>ca :ShowIntentionActions<CR>

" Format file
nnoremap <leader>cf :action ReformatCode<CR>

" Run / Debug
nnoremap <leader>rr :Run<CR>
nnoremap <leader>rd :Debug<CR>
nnoremap <leader>rs :Stop<CR>

" Toggle breakpoint
nnoremap <leader>bp :ToggleLineBreakpoint<CR>

" Next / previous error
nnoremap ]e :GotoNextError<CR>
nnoremap [e :GotoPreviousError<CR>

" Next / previous method
nnoremap ]m :MethodDown<CR>
nnoremap [m :MethodUp<CR>

" Toggle terminal
nnoremap <leader>t :action ActivateTerminalToolWindow<CR>

" Toggle NERDTree / project view
nnoremap <leader>e :action ActivateProjectToolWindow<CR>

" Split editor
nnoremap <leader>sv :SplitVertically<CR>
nnoremap <leader>sh :SplitHorizontally<CR>

" Close current editor tab
nnoremap <leader>q :CloseContent<CR>

" ============================================================
"  GIT ACTIONS
" ============================================================
nnoremap <leader>gb :Git.Branches<CR>
nnoremap <leader>gc :CheckinProject<CR>
nnoremap <leader>gp :Vcs.Push<CR>
nnoremap <leader>gl :Vcs.Show.Log<CR>
nnoremap <leader>gd :Compare.SameVersion<CR>

" ============================================================
"  MISC
" ============================================================
" Easier beginning / end of line
nnoremap H ^
nnoremap L $
vnoremap H ^
vnoremap L $

" Select all
nnoremap <leader>a ggVG

" Duplicate line
nnoremap <leader>dl yyp
vnoremap <leader>dl y'>p

