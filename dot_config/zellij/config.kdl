// ── Behaviour ──────────────────────────────────────────────────
default_shell        "fish"           // change to bash/zsh if needed
default_layout       "default"
default_mode         "normal"
on_force_close       "detach"         // keeps session alive when terminal closes

mouse_mode           true
copy_on_select       false            // don't auto-copy on highlight
copy_command         "wl-copy"        // wayland clipboard
copy_clipboard       "system"

scroll_buffer_size   10000
scrollback_editor    "/usr/bin/nvim"  // change to your editor

// ── Session resurrection ───────────────────────────────────────
session_serialization         true    // survive reboots
pane_viewport_serialization   true    // restore visible content too
serialization_interval        60      // save every 60s

// ── UI ─────────────────────────────────────────────────────────
pane_frames              true
auto_layout              true
stacked_resize           true
styled_underlines        true
show_startup_tips        false
show_release_notes       false

ui {
    pane_frames {
        rounded_corners  true
        hide_session_name false
    }
}

// ── Theme ──────────────────────────────────────────────────────
theme "catppuccin-mocha"

// ── Keybinds ───────────────────────────────────────────────────
keybinds clear-defaults=false {
    normal {
        // Pane management
        bind "Ctrl h" { MoveFocus "Left"; }
        bind "Ctrl j" { MoveFocus "Down"; }
        bind "Ctrl l" { MoveFocus "Right"; }
        bind "Ctrl k" { MoveFocus "Up"; }
    }

    shared_except "locked" {
        // New pane
        bind "Ctrl n" { NewPane; }
        bind "Ctrl Shift n" { NewPane "Down"; }

        // Close pane
        bind "Ctrl w" { CloseFocus; }

        // Splits — mirrors your hyprland backslash bind conceptually
        bind "Ctrl \\" { NewPane "Right"; }
        bind "Ctrl -"  { NewPane "Down"; }

        // Tabs
        bind "Ctrl t"       { NewTab; }
        bind "Ctrl Shift w" { CloseTab; }
        bind "Ctrl ]"       { GoToNextTab; }
        bind "Ctrl ["       { GoToPreviousTab; }
        bind "Ctrl 1"       { GoToTab 1; }
        bind "Ctrl 2"       { GoToTab 2; }
        bind "Ctrl 3"       { GoToTab 3; }
        bind "Ctrl 4"       { GoToTab 4; }
        bind "Ctrl 5"       { GoToTab 5; }

        // Fullscreen / zoom
        bind "Ctrl f"  { ToggleFocusFullscreen; }
        bind "Ctrl z"  { TogglePaneFrames; }

        // Session manager
        bind "Ctrl o" { SwitchToMode "Session"; }

        // Resize mode
        bind "Ctrl r" { SwitchToMode "Resize"; }

        // Detach (session keeps running)
        bind "Alt d" { Detach; }
        
        bind "Alt c" { Copy; }
    }

    resize {
        bind "h" { Resize "Increase Left"; }
        bind "j" { Resize "Increase Down"; }
        bind "k" { Resize "Increase Up"; }
        bind "l" { Resize "Increase Right"; }
        bind "H" { Resize "Decrease Left"; }
        bind "J" { Resize "Decrease Down"; }
        bind "K" { Resize "Decrease Up"; }
        bind "L" { Resize "Decrease Right"; }
        bind "Esc" { SwitchToMode "Normal"; }
    }
}
